# GEMINI_API_KEY: Required for Gemini report generation.
GEMINI_API_KEY="your_gemini_api_key"
# Optional model overrides.
GEMINI_MODEL="gemini-3.6-flash"
GEMINI_FALLBACK_MODEL="gemini-2.5-flash"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# Admin sign-in (set these only in the server or hosting provider's secret settings).
ADMIN_EMAIL="your-admin-email@example.com"
ADMIN_PASSWORD="replace-with-a-unique-password"
ADMIN_SESSION_SECRET="replace-with-at-least-32-random-characters"

# --- LIVE EMAIL DISPATCH CONFIGURATION ---
# Resend is preferred when configured.
RESEND_API_KEY="re_your_api_key"

# SMTP is used when RESEND_API_KEY is not set.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
EMAIL_FROM="oracle@theragemediagroup.com"
